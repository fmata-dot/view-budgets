# Copy to .env.test for local testing against the Docker SQL Server
# and the Google Sheet TEST COPY. Never commit this file.

# Google Sheets -- points at the safe test copy, not production
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_SHEET_ID=1lcEciNjyUuqI136T-UGys_SpA2UYHKKP_rbeiFpYLTo

# SQL Server -- the local Docker container (see docker/docker-compose.yml)
SQL_SERVER=localhost
SQL_DATABASE=BudgetSyncTest
SQL_USER=sa
SQL_PASSWORD=ChangeMe_TestOnly!1

# Must match SQL_PASSWORD above -- used by docker-compose.yml to set
# the container's SA password.
TEST_SQL_SA_PASSWORD=ChangeMe_TestOnly!1
